# TigerGraph Savanna (host from Admin Portal URL `domain=` param; no scheme)
TG_HOST=
TG_GRAPH=FraudGraph
TG_USER=
TG_SECRET=
# LLM providers (OpenAI-compatible). Keys stay in .env, never committed.
GEMINI_API_KEY=
NVIDIA_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# provider:model, tried in order on 5xx/timeout
LLM_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.1-flash-lite,nvidia:nvidia/nemotron-3-ultra-550b-a55b,nvidia:nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
EMBEDDING_PROVIDER=local
